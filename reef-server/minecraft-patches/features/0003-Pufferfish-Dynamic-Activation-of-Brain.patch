diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index c18823746ab2edcab536cb1589b7720e3af07e0f..9341717729de39b7fc879dd116d61a9f855e679c 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -165,6 +165,22 @@ public final class ActivationRange {
                 }
 
                 ActivationRange.activateEntity(entity);
+
+                // Reef start - Pufferfish - Dynamic Activation of Brain
+                if (dev.reef.ReefConfig.dabEnabled && entity.getType().dabEnabled
+                    && (!dev.reef.ReefConfig.dabDontEnableIfInWater || entity.getType().is(net.minecraft.tags.EntityTypeTags.CAN_BREATHE_UNDER_WATER) || !entity.isInWater())) {
+                    if (!entity.activatedPriorityReset) {
+                        entity.activatedPriorityReset = true;
+                        entity.activatedPriority = dev.reef.ReefConfig.dabMaximumActivationPriority;
+                    }
+                    final int squaredDistance = (int) player.distanceToSqr(entity);
+                    entity.activatedPriority = squaredDistance > dev.reef.ReefConfig.dabStartDistanceSquared
+                        ? Math.max(1, Math.min(squaredDistance >> dev.reef.ReefConfig.dabActivationDistanceMod, entity.activatedPriority))
+                        : 1;
+                } else {
+                    entity.activatedPriority = 1;
+                }
+                // Reef end - Pufferfish - Dynamic Activation of Brain
             }
         }
     }
