diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 3bf618f1d756bad7755a87803132bd731e7c41be..18a14c117b738d1725b6d87009fcb57b3051a63d 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -367,6 +367,18 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     public boolean fixedPose = false; // Paper - Expand Pose API
     private final int despawnTime; // Paper - entity despawn time limit
     public int totalEntityAge; // Paper - age-like counter for all entities
+    // Reef start - Pufferfish - Dynamic Activation of Brain
+    public boolean activatedPriorityReset = false;
+    public int activatedPriority = 1; // ticks between brain ticks ("golf score"), 1 = every tick
+    private int dabBehaviorTick = 0;
+
+    public final boolean reefShouldTickBrain() {
+        if (!dev.reef.ReefConfig.dabEnabled || !this.getType().dabEnabled || this.activatedPriority <= 1) {
+            return true;
+        }
+        return this.dabBehaviorTick++ % this.activatedPriority == 0;
+    }
+    // Reef end - Pufferfish - Dynamic Activation of Brain
     public final io.papermc.paper.entity.activation.ActivationType activationType = io.papermc.paper.entity.activation.ActivationType.activationTypeFor(this); // Paper - EAR 2/tracking ranges
     // Paper start - EAR 2
     public final boolean defaultActivationState;
