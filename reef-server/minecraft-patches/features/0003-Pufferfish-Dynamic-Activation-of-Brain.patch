diff --git a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
index 389f773e22872778fc434ad47f3a983b490a0284..d7d2b4015c93e4b98a3a0a41b89678c0d29e270a 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerPanicTrigger.java
@@ -36,7 +36,20 @@ public class VillagerPanicTrigger extends Behavior<Villager> {
 
     @Override
     protected void tick(ServerLevel level, Villager owner, long gameTime) {
-        if (gameTime % 100L == 0L) {
+        // Reef start - Pufferfish - Dynamic Activation of Brain
+        // A throttled brain may never tick on an exact multiple of 100, so use a timer instead.
+        final boolean throttled = dev.reef.ReefConfig.dabEnabled && owner.getType().dabEnabled && owner.activatedPriority > 1;
+        final boolean shouldCheck;
+        if (throttled) {
+            if (owner.nextGolemPanic < 0) owner.nextGolemPanic = gameTime + 100;
+            shouldCheck = gameTime >= owner.nextGolemPanic;
+            if (shouldCheck) owner.nextGolemPanic = -1;
+        } else {
+            owner.nextGolemPanic = -1;
+            shouldCheck = gameTime % 100L == 0L; // vanilla
+        }
+        if (shouldCheck) {
+            // Reef end - Pufferfish - Dynamic Activation of Brain
             owner.spawnGolemIfNeeded(level, gameTime, 3);
         }
     }
