+    // Reef start - async player data saving
+    // Latest pending save per player; saves run in order on a single thread.
+    private final java.util.concurrent.ConcurrentHashMap<java.util.UUID, java.util.concurrent.CompletableFuture<Void>> pendingSaves = new java.util.concurrent.ConcurrentHashMap<>();
+
+    private void writePlayerData(final String stringUuid, final String name, final CompoundTag compoundTag) {
+        try {
+            Path path = this.playerDir.toPath();
+            Path path1 = Files.createTempFile(path, stringUuid + "-", ".dat");
+            NbtIo.writeCompressed(compoundTag, path1);
+            Path path2 = path.resolve(stringUuid + ".dat");
+            Path path3 = path.resolve(stringUuid + ".dat_old");
+            Util.safeReplaceFile(path2, path1, path3);
+        } catch (Exception exception) {
+            LOGGER.warn("Failed to save player data for {}", name, exception);
+        }
+    }
+
+    // A player who quits and rejoins quickly must load the data that is still being written.
+    private void waitForPendingSave(final java.util.UUID uuid, final String name) {
+        final java.util.concurrent.CompletableFuture<Void> future = this.pendingSaves.get(uuid);
+        if (future == null) {
+            return;
+        }
+        try {
+            future.get(10L, java.util.concurrent.TimeUnit.SECONDS);
+        } catch (final InterruptedException exception) {
+            Thread.currentThread().interrupt();
+        } catch (final Exception exception) {
+            LOGGER.warn("Timed out waiting for the previous player data save of {}", name, exception);
+        }
+    }
+    // Reef end - async player data saving
+
     private void backup(NameAndId nameAndId, String suffix) {
