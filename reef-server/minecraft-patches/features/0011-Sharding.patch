-        if (!spawnCategories.isEmpty() && spawnState != null) { // Reef - Pufferfish - Optimize mob spawning
+        if (!spawnCategories.isEmpty() && spawnState != null && dev.reef.sharding.Sharding.ownsChunk(this.level, pos)) { // Reef - Pufferfish - Optimize mob spawning // Reef - sharding
             if (this.level.getWorldBorder().isWithinBounds(pos)) { // Paper - rewrite chunk system
                 NaturalSpawner.spawnForChunk(this.level, chunk, spawnState, spawnCategories);
             }
